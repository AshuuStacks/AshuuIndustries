# Copiez ce fichier sous le nom .env et remplacez les valeurs d'exemple.
# Plusieurs comptes : identifiant:motDePasse,identifiant2:motDePasse2
# Les virgules ne sont pas autorisées dans un mot de passe.
ADMIN_ACCOUNTS=

# Configuration SMTP nécessaire pour l'envoi des confirmations.
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-smtp-app-password
